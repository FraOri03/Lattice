{
  "1": {
    "class_type": "UpscaleModelLoader",
    "inputs": { "model_name": "RealESRGAN_x4plus.pth" },
    "_meta": { "title": "Real-ESRGAN x4" }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": { "image": "input.png", "upload": "image" },
    "_meta": { "title": "Source image" }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": { "upscale_model": ["1", 0], "image": ["2", 0] },
    "_meta": { "title": "Upscale (always 4x)" }
  },
  "4": {
    "class_type": "ImageScaleBy",
    "inputs": { "image": ["3", 0], "upscale_method": "lanczos", "scale_by": 1 },
    "_meta": { "title": "Resample to the requested factor" }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "lattice", "images": ["4", 0] },
    "_meta": { "title": "Output" }
  }
}
