# ── Lattice environment variables ──────────────────────────────────────────
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.
#
# IMPORTANT: VITE_* variables are inlined into the client bundle AT BUILD
# TIME. Adding or changing them on Vercel requires a REDEPLOY of the
# Production environment before they take effect.

# Google OAuth 2.0 Web client id (Google Cloud Console → Credentials).
# Required for real sign-in and Google Drive sync. When empty, Lattice
# falls back to a local mock account and Drive sync stays disabled.
# Checklist for production:
#   1. OAuth client type "Web application"
#   2. Your deploy URL (e.g. https://<app>.vercel.app) is listed under
#      "Authorized JavaScript origins"
#   3. "Google Drive API" is enabled in the same Google Cloud project
#   4. Set for the Production environment on Vercel, then redeploy
VITE_GOOGLE_CLIENT_ID=

# Optional Google API key. The Drive REST calls Lattice makes are all
# OAuth-authenticated, so this is only needed if you enable discovery-
# based Google APIs later.
VITE_GOOGLE_API_KEY=

# Name of the root folder Lattice creates in the user's Drive.
VITE_GOOGLE_DRIVE_APP_FOLDER=Lattice

# GitHub OAuth app client id (github.com/settings/developers).
# Enables one-click "Connect GitHub" via the /api/github/oauth function.
# Without it, users can still connect by pasting a personal access token.
VITE_GITHUB_CLIENT_ID=

# GitHub OAuth app client secret — SERVER-SIDE ONLY. Read exclusively by
# the Vercel serverless function api/github/oauth.ts to exchange the
# OAuth code for a token. Do NOT prefix with VITE_ (that would leak it
# into the client bundle). Only needed when VITE_GITHUB_CLIENT_ID is set.
GITHUB_CLIENT_SECRET=

# ── Realtime collaboration (Phase 8) ───────────────────────────────────────
# Backend switch. Set to "liveblocks" to enable true cross-device realtime
# (CRDT documents/code/boards, live cursors, server-enforced permissions).
# When empty, Lattice honestly reports that no realtime backend is
# configured; tabs of the same browser still collaborate via CRDT locally.
VITE_REALTIME_BACKEND=

# Liveblocks secret key — SERVER-SIDE ONLY (no VITE_ prefix; never bundled).
# Read by api/realtime/auth.ts and api/realtime/rooms.ts to verify Google
# identities and mint scoped room tokens. Create it at liveblocks.io.
# Requires VITE_GOOGLE_CLIENT_ID too: realtime identity is Google identity.
LIVEBLOCKS_SECRET_KEY=

# Optional overrides for the serverless endpoints (defaults shown).
# VITE_REALTIME_AUTH_URL=/api/realtime/auth
# VITE_REALTIME_ROOMS_URL=/api/realtime/rooms

# ── Project calls — audio / camera / screen share (LiveKit) ────────────────
# Media travels over LiveKit and NOTHING else changes: Liveblocks + Yjs keep
# owning CRDT content, presence, cursors, comments, roles and content
# permissions. Audio/video is never tunnelled through Liveblocks.
#
# When these are empty Lattice keeps working exactly as before: the "Join
# call" control is disabled and says calls are not configured — it never
# pretends a call is available, and no connection is attempted.
#
# LiveKit server URL the BROWSER connects to (wss://…). Public on purpose:
# it is an endpoint, not a credential — access is granted only by the
# short-lived token signed server-side. Get it from LiveKit Cloud or your
# self-hosted deployment.
VITE_LIVEKIT_URL=

# LiveKit API key/secret — SERVER-SIDE ONLY (no VITE_ prefix; never bundled).
# Read exclusively by api/realtime/media-token.ts to sign a token scoped to
# one project's room, with the capabilities the caller's role allows.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# NOTE: project calls also require the realtime backend above. Membership is
# read from the project ACL stored in the Liveblocks room metadata, so with
# LIVEBLOCKS_SECRET_KEY missing there is no server-side membership to check
# and the endpoint honestly answers 501.

# Optional override for the media endpoint (default shown).
# VITE_MEDIA_TOKEN_URL=/api/realtime/media-token

# ── Supabase backend (Phase 17) ────────────────────────────────────────────
# Postgres holds identity, project membership, invitations and account
# entitlements. It never holds document content: docs, boards, sheets, code
# and presentations stay in Yjs/Liveblocks and Google Drive.
#
# When these are empty Lattice keeps working exactly as before — identity
# lives in the browser and the ACL in Liveblocks room metadata. Endpoints
# that genuinely need a database answer 501 and say so; nothing crashes.
#
# NOTE: on Vercel these are written by the Supabase integration, which also
# writes NEXT_PUBLIC_-prefixed copies. Those are inert here — Vite only
# inlines VITE_*, so nothing Supabase reaches the client bundle, which is
# exactly the arrangement 16.3 asks for: the browser holds no Supabase
# credential at all.
SUPABASE_URL=

# SERVER-SIDE ONLY, and the reason none of these carry a VITE_ prefix: that
# prefix is compiled into the client bundle at build time, so a secret
# behind it is a published secret.
#
# The server bypasses row level security deliberately. RLS is enabled with
# NO policies on every table, so `anon` can read and write nothing — it is a
# backstop against a leaked key, not the authorisation mechanism, which
# lives in /api (docs/authorisation-phase-16-3.md).
#
# Supabase is renaming service_role to sb_secret_…; both names are accepted
# and the new one wins when both are set. Giving either one a PUBLIC key is
# refused at startup rather than silently producing a deployment where every
# query returns nothing.
SUPABASE_SECRET_KEY=
# Legacy name for the same thing; only needed if SUPABASE_SECRET_KEY is unset.
SUPABASE_SERVICE_ROLE_KEY=

# ── E-mail sign-in (Phase 17.3) ────────────────────────────────────────
# Passwordless sign-in sends a six-digit code to an address. Without a mail
# transport there is nowhere to send it, so /api/session answers 501 and the
# login screen says e-mail sign-in is not configured — it never pretends a
# code was sent. Google sign-in is unaffected.
#
# SERVER-SIDE ONLY (no VITE_ prefix; never bundled). Read only by
# api/_lib/mail.ts.
#
# Resend API key — resend.com → API Keys.
RESEND_API_KEY=

# The From: address, e.g. "Lattice <no-reply@yourdomain.com>". The domain
# has to be verified with the provider or every message is rejected.
MAIL_FROM=

# ── Remote conversion worker (Phase 8, optional) ───────────────────────────
# HTTP endpoint of an external conversion service (e.g. headless
# LibreOffice) for legacy DOC/PPT and high-fidelity office conversion.
# Contract: POST {url}/convert (multipart: file, sourceFormat,
# targetFormat, projectId) with a Google Bearer token; response = the
# converted file, with x-conversion-engine / x-conversion-warnings /
# x-conversion-unsupported headers. When empty, the UI honestly reports
# that legacy conversion is unavailable and preserves originals.
VITE_CONVERSION_API_URL=

# Deployment environment label: development | preview | production
VITE_APP_ENV=development

# Version shown under the app name and in the account menu.
#
# Leave it EMPTY in normal deployments: the release string lives in
# PINNED_VERSION (src/lib/version/buildStamp.ts), and with that pin cleared
# the build stamps <major>.<minor> from package.json + a build number that
# grows on its own. Set this only to pin a release from the deploy
# environment, overriding both.
VITE_APP_VERSION=

# Release stage shown next to the version: alpha | beta | stable
VITE_APP_STAGE=alpha
